<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radioWidget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="12dp">

    <TextView
        android:id="@+id/seekIndicator"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center"
        android:text="@string/radio_seeking"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/accent"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/stationName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="RADIO 1"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:maxLines="1"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/seekDown"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:gravity="center"
            android:text="&#8722;"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:background="@drawable/bg_btn_circle"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:id="@+id/frequencyContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp">

            <TextView
                android:id="@+id/frequency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="88.6"
                android:textSize="52sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:textColor="@color/text_primary"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/band"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FM"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/seekUp"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:gravity="center"
            android:text="+"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:background="@drawable/bg_btn_circle"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/radioText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text=""
        android:textSize="17sp"
        android:textColor="@color/text_secondary"
        android:maxLines="1"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/preset1"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="88.6"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_chip" />

        <TextView
            android:id="@+id/preset2"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="95.2"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_chip" />

        <TextView
            android:id="@+id/preset3"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="98.5"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_chip" />

        <TextView
            android:id="@+id/preset4"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="103.7"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_chip" />
    </LinearLayout>
</LinearLayout>
